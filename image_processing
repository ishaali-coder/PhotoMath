#include "address_map.h"

void process_to_binary(short int* buffer);
void median_filter(short int* buffer);
int otsu_threshold(short int* buffer);

int main(void) {
  // Pointers to video-in DMA controller registers
  volatile int* video_in_dma = (int*)VIDEO_IN_BASE;  // 0xFF203060  controls camera capture
  volatile int* edge_detect = (int*)EDGE_DETECT_CTRL_BASE;  // 0xFF203070

  volatile int* KEY_ptr = (int*)KEY_BASE;
  int edge_capture;
  // Clear edge capture register initially
  *(KEY_ptr + 3) = 0xF;

  // Pointer to pixel buffer controller (video-out) - controls VGA output
  volatile int* pixel_buf_ctrl = (int*)PIXEL_BUF_CTRL_BASE;  // 0xFF203020

  // Step 1: Set both video-in DMA and video-out to use the same buffer
  // Default buffer address is 0x08000000 (FPGA on-chip memory)
  *(video_in_dma + 1) = 0x08000000;  //video-in writes directly to what video-out displays

  // Step 2: Disable edge detection (normal image, not edge-detected)
  *edge_detect = 0x0;

  // Step 3: Enable the Video DMA controller (set EN bit)
  // Control register is at 0xFF20306C (offset 3 from VIDEO_IN_BASE)
  *(video_in_dma + 3) = 0x4;  // EN = 1; EN is bit 4
  *(video_in_dma + 4) = 0x1;  // turn off edge detection bit 1

  // Step 4: Enable the pixel buffer controller (video-out)
  // Writing 1 to Buffer register triggers display to start dispalying buffer
  *pixel_buf_ctrl = 1;

  // The DMA continuously writes camera frames to the pixel buffer
  // and the VGA controller continuously reads and displays them
  while (1) {
    edge_capture = *(KEY_ptr + 3);  // edge capture is 0xFF20005C which is 3rd register from base

    if (edge_capture & 0x1) {  // Check if KEY0 (first bit of register) was pressed and released
        *(KEY_ptr + 3) = 0x1;  // Clear KEY0 edge capture bit by writing 1 to first bit
        *(video_in_dma + 3) = 0x0;  // EN = 0 (stop/freeze the camera) no new frames
        short int* frame = (short int*)0x08000000;  // points to the captured image (each pixel = 16bits)

      // Process every pixel and convert to black or white
      process_to_binary(frame);
      median_filter(frame);

      int count = 10000000;  // delay to keep image of question visible
      for (int i = 0; i < count; i++);
      *(video_in_dma + 3) = 0x4;  // EN = 1 to resume live video
    }
  }

  return 0;
}

void process_to_binary(short int* buffer) {
  int total = 320 * 240;

  // Step 1: Get optimal threshold
  int threshold = otsu_threshold(buffer);

  // Step 2: Apply threshold
  for (int i = 0; i < total; i++) {  //loop over all pixels 
    short int pixel = buffer[i];  //get pixel

    int r = (pixel >> 11) & 0x1F;
    int g = (pixel >> 5) & 0x3F;
    int b = pixel & 0x1F;

    int gray = (r * 30 + g * 59 + b * 11) / 100;  //convert to grayscale 

    if (gray > threshold)
      buffer[i] = 0xFFFF;  // white
    else
      buffer[i] = 0x0000;  // black
  }
}

void median_filter(short int* buffer) {  //removes noise from binary image
  // Temporary buffer to store filtered result
  short int temp[320 * 240];  //temporary buffer
  for (int i = 0; i < 320 * 240; i++) {
    temp[i] = buffer[i];
   }

  for (int y = 1; y < 239; y++) {  //avoid borders
    for (int x = 1; x < 319; x++) {
      int values[9];  //store 9 pixels
      int k = 0;

      // Collect 3x3 neighborhood
      for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
          values[k] = buffer[(y + dy) * 320 + (x + dx)];  //take pixel at (x+dx, y+dy) and store it in array
          k = k + 1;  //get surrounding pixels
        }
      }

      // Sort 9 values (simple bubble sort)
      for (int i = 0; i < 9; i++) {
        for (int j = i + 1; j < 9; j++) {
          if (values[j] < values[i]) {
            int temp_val = values[i];
            values[i] = values[j];
            values[j] = temp_val;
          }
        }
      }

      // Take median (middle value)
      temp[y * 320 + x] = values[4];
    }
  }

  // Copy back to original buffer to replace original image 
  for (int i = 0; i < 320 * 240; i++) {
    buffer[i] = temp[i];
  }
}

int otsu_threshold(short int* buffer) {  //function that finds the best threshold automatically from the image 
  int hist[256] = {0};  //histogram array - counts how may pixels have each greyscale value
  int total = 320 * 240;  //total number of pixels

  // Step 1: Build histogram
  for (int i = 0; i < total; i++) {
    short int pixel = buffer[i];  //get pixel value

    //extract RGB values
    int r = (pixel >> 11) & 0x1F;
    int g = (pixel >> 5) & 0x3F;
    int b = pixel & 0x1F;

    int gray = (r * 30 + g * 59 + b * 11) / 100;  //convert to grayscale
    hist[gray]++;  //counts how many pixels have this gray value
  }

  // Step 2: Otsu calculation -  finds the best value that best separates dark and bright pixels
  //sum = summation(gray level * #of pixels)
  float sum = 0;
  for (int i = 0; i < 256; i++) sum += i * hist[i];  //compute total intensity of image

  float sumB = 0;  //intensity of background
  int wB = 0;  //#of pixels in background
  int wF = 0;  //#of pixels in foreground

  float maxVar = 0;
  int threshold = 0;

  for (int t = 0; t < 256; t++) {  //try every possible threshold value
    wB += hist[t];  //add pixels to backgrounf
    if (wB == 0) continue;  //skip is not background

    wF = total - wB;  //remaining is foreground pixels
    if (wF == 0) break;  //stop if no foreground left

    sumB += t * hist[t];  //add intensity to background

    float mB = sumB / wB;  //mean average of background
    float mF = (sum - sumB) / wF;

    //between class variance - measures how well the image is split, bigger = better separation
    float varBetween = (float)wB * wF * (mB - mF) * (mB - mF);

    if (varBetween > maxVar) {
      maxVar = varBetween;
      threshold = t;  //store threshold
    }
  }
  return threshold;
}
